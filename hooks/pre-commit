#!/bin/sh
# Secret scan over the added lines of the staged diff.
# Message-independent by design: git runs pre-commit before a message exists,
# so the test-first and decision-record rules live in hooks/commit-msg.
set -eu

TAB=$(printf '\t')

# Patterns that would otherwise appear here as contiguous literals are assembled
# from fragments at runtime. A table that matches itself refuses its own source,
# so a fresh clone can never commit its own hooks and silently ends up with none.
# See docs/RUN-001-FINDINGS.md, F2. The heredoc below is unquoted for this reason.
gcp_a='"private_key'
gcp_b='_id"'

patterns() {
	cat <<PATTERNS
aws-access-key	AKIA[0-9A-Z]{16}
private-key	-----BEGIN [A-Z ]*PRIVATE KEY-----
slack-token	xox[abprs]-[0-9A-Za-z-]{10,}
github-token	gh[pousr]_[0-9A-Za-z]{20,}
google-api-key	AIza[0-9A-Za-z_-]{35}
gcp-sa-json	${gcp_a}${gcp_b}
generic-secret	(api[_-]?key|secret|password|passwd|token)["'[:space:]]*[:=]["'[:space:]]*[A-Za-z0-9/+=_-]{20,}
PATTERNS
}

found=0
file=""
lineno=0

git diff --cached -U0 | while IFS= read -r line; do
	case "$line" in
	'+++ /dev/null') file="" ;;
	'+++ b/'*) file=${line#+++ b/} ;;
	'@@ '*)
		hunk=${line#*+}
		hunk=${hunk%% *}
		lineno=${hunk%%,*}
		;;
	'+'*)
		[ -n "$file" ] || continue
		added=${line#+}
		while IFS="$TAB" read -r name re; do
			[ -n "$name" ] || continue
			# -e matters: a pattern starting with - is otherwise read as options.
			if printf '%s\n' "$added" | grep -Eq -e "$re"; then
				printf 'REFUSED  secret-scan [%s]  %s:%s\n' "$name" "$file" "$lineno" >&2
				printf '  %s\n' "$added" >&2
				found=1
			fi
		done <<PATLIST
$(patterns)
PATLIST
		lineno=$((lineno + 1))
		;;
	esac
	# The pipeline runs this loop in a subshell, so the verdict travels by file.
	[ "$found" -eq 0 ] || : >"$(git rev-parse --git-dir)/SECRET_SCAN_FAILED"
done

verdict="$(git rev-parse --git-dir)/SECRET_SCAN_FAILED"
if [ -e "$verdict" ]; then
	rm -f "$verdict"
	printf '\nCommit refused: a staged line matches a secret pattern.\n' >&2
	printf 'Remove the secret, or move it to an untracked env file.\n' >&2
	printf 'Override with git commit --no-verify. It leaves no trace in history.\n' >&2
	exit 1
fi

# STATE.md integrity. Message-independent, so it belongs here rather than in
# commit-msg: it needs the staged content and nothing else.
#
# The orchestrator writes .agent/STATE.md and every other agent trusts it. The
# checker validates a diff AGAINST it, so it stands downstream of this file and
# structurally cannot see a fabrication in it. RUN-002 F15: an orchestrator wrote
# checkpoints, PASS verdicts and four SHAs for work that had not happened. It
# caught itself. Self-report is not a control.
STATE_PATH=.agent/STATE.md
STATE_CAP=120

if git diff --cached --name-only | grep -qxF "$STATE_PATH"; then
	state_lines=$(git show ":$STATE_PATH" | wc -l | tr -d ' ')
	if [ "$state_lines" -gt "$STATE_CAP" ]; then
		printf 'REFUSED  state-cap  %s\n' "$STATE_PATH" >&2
		printf '  %s is %s lines, over its %s-line cap.\n' \
			"$STATE_PATH" "$state_lines" "$STATE_CAP" >&2
		printf '  Compact settled facts into .agent/DECISIONS.md and delete them here.\n' >&2
		exit 1
	fi

	# Candidate object ids. Fenced blocks and inline `code` are stripped first:
	# a documented example SHA is not a claim about work that happened.
	state_shas=$(git show ":$STATE_PATH" | awk '
		/^[ \t]*```/ { fence = !fence; next }
		fence { next }
		{
			line = $0
			while (match(line, /`[^`]*`/))
				line = substr(line, 1, RSTART - 1) " " substr(line, RSTART + RLENGTH)
			gsub(/[^0-9A-Za-z]/, " ", line)
			n = split(line, tok, " ")
			for (i = 1; i <= n; i++)
				if (tok[i] ~ /^[0-9a-f]{7,40}$/) printf "%s\t%s\n", NR, tok[i]
		}
	')

	state_bad=0
	seen=" "
	while IFS="$TAB" read -r lineno sha; do
		[ -n "${sha:-}" ] || continue
		case "$seen" in *" $sha "*) continue ;; esac
		seen="$seen$sha "
		if git cat-file -e "$sha^{commit}" 2>/dev/null; then
			continue
		fi
		printf 'REFUSED  state-sha  %s:%s\n' "$STATE_PATH" "$lineno" >&2
		printf '  STATE.md cites a commit that does not exist: %s at line %s. A state\n' \
			"$sha" "$lineno" >&2
		printf '  file that references work which did not happen is the failure this\n' >&2
		printf '  pipeline exists to catch.\n' >&2
		state_bad=1
	done <<STATE_SHAS
$state_shas
STATE_SHAS

	if [ "$state_bad" -ne 0 ]; then
		printf '\n  An intentional example is not a claim: wrap it in `backticks` or put it\n' >&2
		printf '  in a fenced block and this check skips it. Do the same for a SHA that\n' >&2
		printf '  belongs to another repository, such as the upstream pipeline.\n' >&2
		exit 1
	fi
fi

exit 0
